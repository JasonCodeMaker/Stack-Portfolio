{
  "name": "stock-portfolio-desktop",
  "productName": "Stock Portfolio",
  "version": "1.4.17",
  "private": true,
  "description": "Local investment portfolio, allocation and broker reconciliation for Windows",
  "author": "Stock Portfolio",
  "main": "out/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs && vitest run tests/allocation tests/brokers tests/charts tests/ui",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "local.stackportfolio.desktop",
    "productName": "Stock Portfolio",
    "artifactName": "Stock-Portfolio-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "../release/desktop"
    },
    "files": [
      "out/**",
      "package.json",
      "!node_modules/better-sqlite3-multiple-ciphers/{deps,src}/**",
      "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/{darwin*,linux*,win32-arm64}.node",
      "!node_modules/node-addon-api/**"
    ],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "asarUnpack": [
      "node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-x64.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "d3-hierarchy": "3.1.3",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "decimal.js": "10.6.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "lucide-react": "0.561.0",
    "playwright-core": "1.65.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.2.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  }
}
