{
  "name": "stock-portfolio-desktop",
  "productName": "Stock Portfolio",
  "version": "1.0.3",
  "private": true,
  "description": "Local investment portfolio, allocation and broker reconciliation for Windows",
  "author": "Stock Portfolio",
  "main": "out/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/*.test.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "local.stackportfolio.desktop",
    "productName": "Stock Portfolio",
    "artifactName": "Stock-Portfolio-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "../release/desktop"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "decimal.js": "10.6.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "lucide-react": "0.561.0",
    "playwright-core": "1.65.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
