{
  "id": "broker-sync",
  "name": "Broker Sync",
  "version": "0.3.7",
  "description": "Manually synchronize IBKR and Webull activity into Wealthfolio.",
  "author": "Broker Sync",
  "license": "MIT",
  "main": "dist/addon.js",
  "sdkVersion": "3.7.0",
  "minWealthfolioVersion": "3.7.0",
  "enabled": true,
  "contributes": {
    "routes": [{ "id": "broker-sync" }],
    "links": {
      "sidebar": [{
        "id": "broker-sync",
        "route": "broker-sync",
        "label": "Broker Sync",
        "icon": "plugs-connected",
        "order": 94
      }]
    }
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": ["getAll"],
      "purpose": "Map IBKR and Webull records to existing Wealthfolio accounts."
    },
    {
      "category": "activities",
      "functions": ["checkImport", "getAll", "saveMany"],
      "purpose": "Preview activities, detect existing imports, and safely create or repair broker records."
    },
    {
      "category": "portfolio",
      "functions": ["update"],
      "purpose": "Refresh portfolio calculations after a successful import."
    },
    {
      "category": "secrets",
      "functions": ["set", "get", "delete"],
      "purpose": "Store IBKR and Webull credentials in Wealthfolio's system keyring."
    },
    {
      "category": "network",
      "functions": ["request"],
      "purpose": "Download user-requested broker data from official IBKR and Webull Australia hosts."
    }
  ],
  "network": {
    "allowedHosts": ["ndcdyn.interactivebrokers.com", "gdcdyn.interactivebrokers.com", "api.webull.com.au"]
  },
  "hostDependencies": {
    "@wealthfolio/addon-sdk": "^3.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
