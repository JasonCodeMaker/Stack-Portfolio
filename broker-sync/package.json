{
  "name": "wealthfolio-broker-sync-addon",
  "private": true,
  "version": "0.3.7",
  "description": "On-demand IBKR and Webull account synchronization for Wealthfolio",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite build --watch",
    "dev:server": "node scripts/dev-server.cjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "npm run build && node scripts/create-bundle.mjs"
  },
  "dependencies": {
    "@wealthfolio/addon-sdk": "3.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@wealthfolio/addon-dev-tools": "3.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
