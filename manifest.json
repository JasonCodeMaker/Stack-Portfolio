{
  "id": "portfolio-xray",
  "name": "Allocation",
  "version": "0.3.11",
  "description": "Monitor allocation, look-through exposure, and rebalancing in Wealthfolio.",
  "author": "Allocation",
  "license": "MIT",
  "main": "dist/addon.js",
  "sdkVersion": "3.7.0",
  "minWealthfolioVersion": "3.7.0",
  "enabled": true,
  "network": {
    "allowedHosts": [
      "api.twelvedata.com",
      "www.alphavantage.co",
      "www.ishares.com",
      "dng-api.invesco.com",
      "www.betashares.com.au"
    ]
  },
  "contributes": {
    "routes": [
      { "id": "portfolio-xray" }
    ],
    "links": {
      "sidebar": [
        {
          "id": "portfolio-xray",
          "route": "portfolio-xray",
          "label": "Allocation",
          "icon": "chart-bar",
          "order": 95
        }
      ]
    }
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": ["getAll"],
      "purpose": "Read active Wealthfolio accounts for addon account selection."
    },
    {
      "category": "portfolio",
      "functions": ["getHoldings"],
      "purpose": "Read account holdings without modifying Wealthfolio portfolio data."
    },
    {
      "category": "assets",
      "functions": ["getProfile"],
      "purpose": "Resolve canonical instrument identity and asset type."
    },
    {
      "category": "settings",
      "functions": ["get"],
      "purpose": "Verify the Wealthfolio base currency before AUD valuation."
    },
    {
      "category": "currency",
      "functions": ["getAll"],
      "purpose": "Use Wealthfolio exchange rates as a safe USD/AUD fallback."
    },
    {
      "category": "network",
      "functions": ["request"],
      "purpose": "Fetch the USD/AUD quote and public ETF constituent data through Wealthfolio's brokered network."
    },
    {
      "category": "secrets",
      "functions": ["get", "set", "delete"],
      "purpose": "Store provider API keys in Wealthfolio's secret store."
    },
    {
      "category": "events",
      "functions": ["onUpdateComplete", "onSyncComplete"],
      "purpose": "Invalidate addon-derived data when Wealthfolio data changes."
    }
  ],
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.7.0",
    "@wealthfolio/ui": "^3.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  }
}
